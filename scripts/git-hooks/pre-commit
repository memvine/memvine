#!/bin/sh
# Blocks a commit whose staged changes contain a secret. Install once per clone:
#   git config core.hooksPath scripts/git-hooks
# Needs gitleaks (brew install gitleaks, or https://github.com/gitleaks/gitleaks/releases).
# Bypass for a known false positive: fix .gitleaks.toml instead of using --no-verify.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed, skipping secret scan (brew install gitleaks)" >&2
  exit 0
fi
exec gitleaks protect --staged --redact --config .gitleaks.toml --no-banner
