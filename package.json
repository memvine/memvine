{
  "name": "memvine",
  "version": "0.3.0",
  "description": "Git-native memory for coding agents. What your agent learns lives in your repo, travels with the clone, and expires when the code changes.",
  "keywords": [
    "ai",
    "agents",
    "memory",
    "mcp",
    "claude-code",
    "cursor",
    "copilot",
    "git",
    "context"
  ],
  "homepage": "https://memvine.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memvine/memvine.git"
  },
  "license": "MIT",
  "author": "Vishal <sfo.vishal@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memvine": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/architecture.svg"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "benchmark": "npm run build && node benchmark/run.mjs",
    "team-sim": "npm run build && node benchmark/team-sim.mjs",
    "agent-eval": "npm run build && node benchmark/agent-eval.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3",
    "minimatch": "^9.0.0",
    "smol-toml": "^1.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "types": "dist/index.d.ts"
}
