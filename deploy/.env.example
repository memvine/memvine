# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# The operator key: administers every organization. Generate one: python -c "import secrets; print('mv_mk_' + secrets.token_urlsafe(32))"
MEMVINE_OPERATOR_KEY=mv_mk_change-me
# The model that turns conversation into memory. Choose one of the two.
#
# 1. Anthropic (the default, and what Memvine's own checks are run on):
ANTHROPIC_API_KEY=sk-ant-...
# MEMVINE_LLM_MODEL=claude-sonnet-5-5
#
# 2. Any server that speaks the OpenAI API. Delete the ANTHROPIC_API_KEY line above and set these.
#    Other models work but are not measured: see "Other models" in deploy/README.md.
# MEMVINE_LLM_BACKEND=openai
# MEMVINE_LLM_API_KEY=sk-...
# MEMVINE_LLM_MODEL=gpt-5.6
#    A cheaper model for the many small judgements (optional; MEMVINE_LLM_MODEL when unset):
# MEMVINE_LLM_MODEL_FAST=
#    Somewhere other than api.openai.com:
# MEMVINE_LLM_BASE_URL=https://openrouter.ai/api/v1
# MEMVINE_LLM_BASE_URL=http://host.docker.internal:11434/v1     (Ollama on this machine; no key)
# Who may create an account in the console: invite (the default: only with an invite link from an
# organization admin), open (anyone who can reach the server), closed.
# MEMVINE_SIGNUP=invite
# Host ports, if 8400 and 3000 are taken.
# MEMVINE_API_PORT=8400
# MEMVINE_CONSOLE_PORT=3000
